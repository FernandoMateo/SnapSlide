# Dominio público del sitio (SEO: canonical, sitemap, Open Graph). Sin barra final.
NEXT_PUBLIC_SITE_URL=https://snapslide.com

# Hoy la app funciona 100% con datos demo en el navegador.
# Al conectar PocketBase, copia este archivo a .env.local y completa:
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Solo para `npm run seed:pb` (nunca en el frontend ni en producción):
PB_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
